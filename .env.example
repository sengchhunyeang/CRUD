# Copy this file to .env.local and fill in values from
# Supabase dashboard -> Project Settings -> API Keys.

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Access is governed by the RLS policies in supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres connection string, used only by `npm run db:setup` to create tables.
# Dashboard -> Connect -> Session pooler URI (with your database password).
DATABASE_URL=
